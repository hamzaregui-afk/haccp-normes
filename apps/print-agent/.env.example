# NORMES HACCP — Local Print Agent configuration
# Copy this file to .env and fill in your values.

# URL of your HACCP SaaS platform — use the HTTPS domain (valid TLS certificate),
# NOT a raw IP (a self-signed cert is rejected).
HACCP_API_URL=https://app.normes-haccp.com

# Credentials of a dedicated OPERATOR user for this site (least privilege).
HACCP_EMAIL=operator@votreentreprise.com
HACCP_PASSWORD=MotDePasseSecurise

# Printer to serve. Create it once in the web app
#   Paramètres → Impression → Imprimantes → mode « Agent local (USB) »
# then paste its ID here to run the agent HEADLESS (no interactive prompt).
# Leave empty to pick a printer interactively on first run.
HACCP_PRINTER_ID=

# Polling interval in milliseconds (default: 5000 = 5 seconds).
POLL_INTERVAL_MS=5000

# Log level: debug | info | warn | error
LOG_LEVEL=info
