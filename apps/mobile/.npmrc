engine-strict=false
# Ensure hoisting applies even when EAS runs pnpm install with cwd=apps/mobile
# (base directory). RN's Android build (app/build.gradle react{} block) resolves
# @react-native-community/cli / @react-native/codegen via require.resolve from the
# android/ dir; strict pnpm layout hides them → "path may not be null or empty".
node-linker=hoisted
