# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/
.expo/

# Expo prebuild native projects — generated by `expo prebuild` / EAS build FROM
# GitHub. Never commit them: they are regenerated in the cloud from app.json.
# Committing/leaving them locally is the classic source of "local drift" confusion.
apps/mobile/android/
apps/mobile/ios/

# Turbo
.turbo/

# Environment files
.env
.env.local
.env.*.local

# Prisma generated
**/node_modules/.prisma/
# Per-service test-only Prisma clients (see services/*/prisma/schema.prisma
# testClient generator) — regenerated by `pnpm db:generate` in CI.
**/prisma/generated/

# Test coverage
coverage/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp

