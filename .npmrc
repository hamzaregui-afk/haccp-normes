# ARCH-DECISION: node-linker=hoisted (flat node_modules, npm-style).
# React Native's Android build (Expo prebuild settings.gradle autolinking) resolves
# @react-native/gradle-plugin via require.resolve from node_modules. pnpm's strict,
# symlinked layout hides it → the EAS Android build failed with
# "Error resolving plugin [id: 'com.facebook.react.settings'] > Included build
# '.../android/null' does not exist". Hoisting lays dependencies flat so RN's
# autolinking finds them. This is the documented fix for Expo + pnpm monorepos.
# Layout-only change (does not affect the lockfile); more-permissive resolution,
# so backend services keep working.
node-linker=hoisted
