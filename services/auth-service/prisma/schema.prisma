// auth-service owns: User credentials, refresh tokens
// Other services reference userId as a plain String — no cross-service Prisma relations

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  QUALITY_OFFICER
  VIEWER
  OPERATOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
  INVITED
}

model User {
  id           String     @id @default(cuid())
  // ARCH-DECISION: email is globally unique across ALL tenants (not per-tenant).
  // Login uses email+password only — no tenant context provided at login time.
  // Changing to @@unique([email, tenantId]) would require adding a tenant
  // subdomain/slug to the login form — intentionally not done for UX simplicity.
  email        String     @unique
  name         String
  passwordHash String     @map("password_hash")
  role         UserRole   @default(OPERATOR)
  status       UserStatus @default(ACTIVE)
  tenantId     String     @map("tenant_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // ── Password lifecycle (admin-driven reset workflow) ─────────────────────────
  // ARCH-DECISION: These live on the auth-service User because auth-service is the
  // sole owner of credentials. All default to a benign value so the additive
  // migration cannot change the behaviour of existing accounts.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")
  lockedAt           DateTime? @map("locked_at")     // non-null ⇒ account locked, login refused
  lockedBy           String?   @map("locked_by")     // userId of the admin who locked it
  lockReason         String?   @map("lock_reason")

  refreshTokens RefreshToken[]

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// ARCH-DECISION: Append-only history of password resets/locks so SUPER_ADMIN and
// tenant ADMINs can audit "who reset whose password, when, and how". Kept in the
// auth DB (the credential owner) and ALSO mirrored to audit-service via
// emitAuditEvent for the immutable legal log. No UPDATE/DELETE ever runs here.
model PasswordResetEvent {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")           // whose credential was affected
  tenantId          String   @map("tenant_id")
  performedByUserId String   @map("performed_by_user_id")
  method            String                              // ADMIN_RESET | TEMP_GENERATED | SELF_CHANGE | LOCK | UNLOCK
  emailSent         Boolean  @default(false) @map("email_sent")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([tenantId])
  @@map("password_reset_events")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}
